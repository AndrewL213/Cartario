# Copia este archivo como .env.local y rellena los valores.
# .env.local está en .gitignore — nunca se sube al repo.

# --- Supabase (Fase 1) --------------------------------------------------
# supabase.com > tu proyecto > Project Settings > API
#   Project URL           -> NEXT_PUBLIC_SUPABASE_URL
#   Project API keys: anon -> NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe (Fase 3d, modo test) — SOLO servidor ----------------------
#   STRIPE_SECRET_KEY          -> Stripe (test) > Developers > API keys (sk_test_...)
#   STRIPE_PRICE_ID            -> Products > precio recurrente (price_...)
#   STRIPE_WEBHOOK_SECRET      -> `stripe listen --forward-to localhost:3000/api/stripe/webhook` (whsec_...)
#   SUPABASE_SERVICE_ROLE_KEY  -> Supabase > Project Settings > API > service_role (SECRETO)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
