# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase.
# .env.local está en .gitignore — nunca se sube al repo.
#
# Los encuentras en: supabase.com → tu proyecto → Project Settings → API
#   - Project URL           -> NEXT_PUBLIC_SUPABASE_URL
#   - Project API keys: anon -> NEXT_PUBLIC_SUPABASE_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
